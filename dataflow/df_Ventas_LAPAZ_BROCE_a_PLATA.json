{
	"name": "df_Ventas_LAPAZ_BROCE_a_PLATA",
	"properties": {
		"folder": {
			"name": "BRONCE"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_LaPaz_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ventas_SantaCruz_Casilimpio",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "TRIM"
				},
				{
					"name": "SucursalLaPaz"
				},
				{
					"name": "PrecioUnitario"
				},
				{
					"name": "producto"
				},
				{
					"name": "Cantidad"
				},
				{
					"name": "Fecha"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "ClienteEmail"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_Venta as string,",
				"          Fecha_Venta as string,",
				"          Producto as string,",
				"          Cant as string,",
				"          PrecioUnit as string,",
				"          Sucursal as string,",
				"          Vendedor as string,",
				"          NombreCliente as string,",
				"          EmailCliente as string,",
				"          MetodoPago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = ID_Venta,",
				"          fecha = Fecha_Venta,",
				"          producto = Producto,",
				"          cantidad = Cant,",
				"          precio_unitario = PrecioUnit,",
				"          sucursal = Sucursal,",
				"          vendedor = Vendedor,",
				"          nombre_cliente = NombreCliente,",
				"          cliente_email = EmailCliente,",
				"          metodo_pago = MetodoPago",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          sucursal = trim(sucursal),",
				"          vendedor = trim(vendedor),",
				"          nombre_cliente = trim(nombre_cliente),",
				"          cliente_email = trim(cliente_email),",
				"          metodo_pago = trim(metodo_pago),",
				"          producto = trim(producto)) ~> TRIM",
				"TRIM derive(sucursal = iif(isNull(sucursal), 'La Paz', 'La Paz'),",
				"          canal = 'Sucursal') ~> SucursalLaPaz",
				"SucursalLaPaz derive(precio_unitario = iif(\r",
				"    isNull(precio_unitario) || trim(toString(precio_unitario)) == '', \r",
				"    toFloat(0.0), \r",
				"    toFloat(round(toFloat(trim(replace(replace(replace(lower(toString(precio_unitario)), 'bob', ''), 'bs.', ''), 'bs', ''))), 2))\r",
				")) ~> PrecioUnitario",
				"PrecioUnitario derive(producto = initCap(trim(regexReplace(replace(toString(producto), '\"', ''), '\\\\s+', ' ')))) ~> producto",
				"producto derive(cantidad = iifNull(toInteger(toFloat(trim(toString(cantidad)))), 0)) ~> Cantidad",
				"Cantidad derive(fecha = coalesce(toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'yyyy-MM-dd'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'dd-MMM-yyyy'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'dd-MMMM-yyyy'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'MMMM dd yyyy'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'dd/MM/yyyy'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'dd-MM-yyyy'),toDate(trim(replace(replace(toString(fecha),' de ','-'),',','')),'yyyy/MM/dd'))) ~> Fecha",
				"Fecha derive(vendedor = iifNull(trim(vendedor), 'Sin Vendedor Asignado')) ~> derivedColumn1",
				"derivedColumn1 derive(cliente_email = iifNull(trim(cliente_email), 'No Proporcionado')) ~> ClienteEmail",
				"ClienteEmail filter(!isNull(id_venta) && !isNull(fecha) && !isNull(producto) && !isNull(cantidad) && !isNull(precio_unitario) && !isNull(sucursal) && !isNull(vendedor) && !isNull(nombre_cliente) && !isNull(cliente_email) && !isNull(metodo_pago)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['ventas_LAPAZ_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}