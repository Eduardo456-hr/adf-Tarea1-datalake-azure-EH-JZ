{
	"name": "df_Ventas_Online_BRONCE_a_PLATA",
	"properties": {
		"folder": {
			"name": "BRONCE"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "TRIM"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          {customer/name} as string,",
				"          {customer/email} as string,",
				"          {customer/city} as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string,",
				"          customer as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          nombre_cliente = {customer/name},",
				"          cliente_email = {customer/email},",
				"          sucursal = {customer/city},",
				"          metodo_pago = payment_method,",
				"          canal = channel",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          nombre_cliente = trim(nombre_cliente),",
				"          cliente_email = trim(cliente_email),",
				"          sucursal = trim(sucursal),",
				"          metodo_pago = trim(metodo_pago),",
				"          canal = 'Sucursal') ~> TRIM",
				"TRIM derive(fecha = coalesce(toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'yyyy-MM-dd'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MMM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MMMM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'MMMM dd yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd/MM/yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'yyyy/MM/dd'))) ~> derivedColumn1"
			]
		}
	}
}