{
	"name": "df_Ventas_Online_BRONCE_a_PLATA",
	"properties": {
		"folder": {
			"name": "BRONCE"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ventas_Online_Limpio",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "TRIM"
				},
				{
					"name": "Fecha"
				},
				{
					"name": "TODO"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          {customer/name} as string,",
				"          {customer/email} as string,",
				"          {customer/city} as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string,",
				"          customer as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          cliente_nombre = {customer/name},",
				"          cliente_email = {customer/email},",
				"          sucursal = {customer/city},",
				"          metodo_pago = payment_method,",
				"          vendedor = channel",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          nombre_cliente = trim(cliente_nombre),",
				"          cliente_email = trim(cliente_email),",
				"          sucursal = trim(sucursal),",
				"          metodo_pago = trim(metodo_pago),",
				"          canal = 'Sucursal',",
				"          vendedor = trim(vendedor)) ~> TRIM",
				"TRIM derive(fecha = coalesce(toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'yyyy-MM-dd'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MMM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MMMM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'MMMM dd yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd/MM/yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'dd-MM-yyyy'),toDate(trim(replace(replace(replace(toString(fecha),'T00:00:00',''),' de ','-'),',','')),'yyyy/MM/dd'))) ~> Fecha",
				"Fecha derive(precio_unitario = iif(isNull(precio_unitario) || trim(toString(precio_unitario)) == '', toFloat(0.0), toFloat(round(toFloat(trim(replace(replace(replace(lower(toString(precio_unitario)), 'bob', ''), 'bs.', ''), 'bs', ''))), 2))),",
				"          cantidad = abs(iifNull(toInteger(toFloat(trim(toString(cantidad)))), 0)),",
				"          producto = initCap(trim(regexReplace(replace(toString(producto), '\"', ''), '\\\\s+', ' '))),",
				"          cliente_nombre = iifNull(trim(toString(cliente_nombre)), 'Cliente Desconocido'),",
				"          cliente_email = iifNull(trim(toString(cliente_email)), 'Sin Correo'),",
				"          metodo_pago = iifNull(trim(toString(metodo_pago)), 'Desconocido'),",
				"          sucursal = case(\r",
				"    isNull(sucursal) || trim(toString(sucursal)) == '', 'No Especificada',\r",
				"    in(['santa cruz', 'scz'], lower(trim(toString(sucursal)))), 'Santa Cruz',\r",
				"    in(['cochabamba', 'cbba'], lower(trim(toString(sucursal)))), 'Cochabamba',\r",
				"    in(['la paz', 'lp', 'lapaz'], lower(trim(toString(sucursal)))), 'La Paz',\r",
				"    in(['potosi', 'potosí'], lower(trim(toString(sucursal)))), 'Potosí',\r",
				"    initCap(trim(toString(sucursal)))\r",
				")) ~> TODO",
				"TODO filter(!isNull(id_venta) && !isNull(fecha) && !isNull(producto) && !isNull(cantidad) && !isNull(precio_unitario) && !isNull(sucursal) && !isNull(vendedor) && !isNull(cliente_nombre) && !isNull(cliente_email) && !isNull(metodo_pago)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_venta as string,",
				"          fecha as string,",
				"          producto as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          nombre_cliente as string,",
				"          cliente_email as string,",
				"          sucursal as string,",
				"          metodo_pago as string,",
				"          vendedor as string,",
				"          canal as string",
				"     ),",
				"     partitionFileNames:['Ventas_Online_Limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}